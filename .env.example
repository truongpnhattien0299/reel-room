# --- Database (Neon) — copy from "Connect" in the Neon dashboard; default db name `neondb` is fine ---
DATABASE_URL="postgresql://neondb_owner:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="reelroom"

# --- Email: Resend or SMTP. Leave both empty in dev: emails are printed to the server console. ---
# EMAIL_PROVIDER="resend" | "smtp" — optional; by default Resend if RESEND_API_KEY is set, else SMTP if SMTP_HOST is.
EMAIL_PROVIDER=""
EMAIL_FROM="ReelRoom <noreply@example.com>"
# Resend (needs a verified domain)
RESEND_API_KEY=""
# SMTP, e.g. Gmail: smtp.gmail.com / 465 / your address / an App Password (EMAIL_FROM must be that address)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# --- Vercel Cron (set the same value in Vercel project env) ---
CRON_SECRET=""
