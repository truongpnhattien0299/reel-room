# --- Database (Neon) ---
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/reelroom?sslmode=require"

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="reelroom"

# --- Email (Resend). Leave empty in dev: emails are printed to the server console. ---
RESEND_API_KEY=""
EMAIL_FROM="ReelRoom <noreply@example.com>"

# --- Vercel Cron (set the same value in Vercel project env) ---
CRON_SECRET=""
